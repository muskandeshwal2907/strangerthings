# ==============================================================================
# THE HAWKINS PROTOCOL — PRODUCTION & DEPLOYMENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel / Next.js)
# ------------------------------------------------------------------------------
# Backend Base URL (Render Express + Socket.IO deployment)
NEXT_PUBLIC_BACKEND_URL=https://hawkins-backend.onrender.com

# Backend API Endpoint URL
NEXT_PUBLIC_API_URL=https://hawkins-backend.onrender.com/api

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render / Express / Socket.IO)
# ------------------------------------------------------------------------------
# Port binding (Dynamic on Render, defaults to 5000 locally)
PORT=5000

# CORS Allowed Origins (* or specific frontend domain)
CORS_ORIGIN=https://hawkins-protocol.vercel.app

# Cryptographic and Auth Secrets
JWT_SECRET=HAWKINS_NATIONAL_LAB_SECRET_KEY_1983
ADMIN_PASSKEY=HAWKINS_CHIEF_1983
ANSWER_HMAC_SECRET=HAWKINS_SECRET_HMAC_KEY_1983
SESSION_TOKEN_PEPPER=HAWKINS_SESSION_PEPPER_1983
ADMIN_SESSION_SECRET=HAWKINS_CHIEF_ADMIN_SECRET_1983

# Tournament Game Duration (seconds, default 90 min = 5400)
TOTAL_GAME_TIME=5400

# ------------------------------------------------------------------------------
# 3. DISTRIBUTED DATABASE CONFIGURATION (TiDB Serverless)
# ------------------------------------------------------------------------------
# Recommended: Full TiDB Database Connection URI with TLS/SSL enabled
TIDB_DATABASE_URL=mysql://<user>:<password>@<gateway-host>.prod.aws.tidbcloud.com:4000/stranger_thinks?ssl={"rejectUnauthorized":true}

# Alternative granular TiDB connection parameters:
TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=root
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=stranger_thinks
TIDB_SSL=true
